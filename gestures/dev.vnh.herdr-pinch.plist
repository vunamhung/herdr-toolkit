<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.vnh.herdr-pinch</string>
  <key>ProgramArguments</key><array><string>HOME_DIR/.local/bin/herdr-pinch</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HERDR_APP</key><string>HOME_DIR/.local/bin/herdr-app</string>
    <key>HERDR_PINCH_LOG</key><string>HOME_DIR/Library/Logs/herdr-pinch.log</string>
    <key>HERDR_PINCH_TOGETHER</key><string>vnh-tabs.git-pull</string>
    <key>HERDR_PINCH_APART</key><string>vnh-tabs.git-push</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
