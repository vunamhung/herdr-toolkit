{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "BUN=$(command -v bun || echo \"$HOME/.bun/bin/bun\"); f=\"${HERDR_APP_HOME:-$HOME/.config/herdr-app}/mods/vnh-filetree/bridge.ts\"; [ -x \"$BUN\" ] && [ -f \"$f\" ] && \"$BUN\" \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Grep|Glob|Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "BUN=$(command -v bun || echo \"$HOME/.bun/bin/bun\"); f=\"${HERDR_APP_HOME:-$HOME/.config/herdr-app}/mods/vnh-filetree/bridge.ts\"; [ -x \"$BUN\" ] && [ -f \"$f\" ] && \"$BUN\" \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "BUN=$(command -v bun || echo \"$HOME/.bun/bin/bun\"); f=\"${HERDR_APP_HOME:-$HOME/.config/herdr-app}/mods/vnh-filetree/bridge.ts\"; [ -x \"$BUN\" ] && [ -f \"$f\" ] && \"$BUN\" \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "BUN=$(command -v bun || echo \"$HOME/.bun/bin/bun\"); f=\"${HERDR_APP_HOME:-$HOME/.config/herdr-app}/mods/vnh-filetree/bridge.ts\"; [ -x \"$BUN\" ] && [ -f \"$f\" ] && \"$BUN\" \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
