{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test -x \"$HOME/.bun/bin/bun\" && \"$HOME/.bun/bin/bun\" \"$HOME/.config/herdr-app/mods/filetree/bridge.ts\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Grep|Glob|Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test -x \"$HOME/.bun/bin/bun\" && \"$HOME/.bun/bin/bun\" \"$HOME/.config/herdr-app/mods/filetree/bridge.ts\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test -x \"$HOME/.bun/bin/bun\" && \"$HOME/.bun/bin/bun\" \"$HOME/.config/herdr-app/mods/filetree/bridge.ts\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -x \"$HOME/.bun/bin/bun\" && \"$HOME/.bun/bin/bun\" \"$HOME/.config/herdr-app/mods/filetree/bridge.ts\" || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
