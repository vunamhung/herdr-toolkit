{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HERDR_APP_HOME:-$HOME/.config/herdr-app}/mods/walkthrough/hooks/turn.sh\"; [ -f \"$f\" ] && sh \"$f\" start || true",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HERDR_APP_HOME:-$HOME/.config/herdr-app}/mods/walkthrough/hooks/turn.sh\"; [ -f \"$f\" ] && sh \"$f\" stop || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
